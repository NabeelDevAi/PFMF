# Copy to .env and fill in. .env is gitignored; this file is the documented shape.

ENVIRONMENT=local

# Local Postgres, connecting as the postgres superuser over the unix socket
# with a local trust rule (no password needed locally). Adjust the socket
# path if your local setup differs.
DATABASE_URL=postgresql+psycopg://postgres@/pfmf_dev?host=/var/run/postgresql
TEST_DATABASE_URL=postgresql+psycopg://postgres@/pfmf_test?host=/var/run/postgresql

# Generate your own locally, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-locally

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
MAX_HORIZON_MONTHS=120
MAX_TRANSACTIONS_PER_SCENARIO=500
